# Oura Agent Backend Configuration
# Copy this file to ../.env (project root) and fill in values

# =============================================================================
# Oura OAuth (required)
# =============================================================================
# Get these from https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:8000/oura/callback
OURA_SCOPES=daily personal

# =============================================================================
# Storage
# =============================================================================
# SQLite database for local development
DATABASE_URL=sqlite:///./local.db

# Maximum days to keep cached Oura data (per data agreement)
OURA_CACHE_MAX_DAYS=60

# =============================================================================
# Web App
# =============================================================================
# URL of the React frontend (for OAuth redirects)
WEB_APP_URL=http://localhost:5173

# =============================================================================
# Sync Settings
# =============================================================================
# Days to fetch during light refresh (default: 7)
OURA_REFRESH_DAYS=7

# Enable periodic background refresh (default: false)
ENABLE_SCHEDULER=false

# Hours between scheduled refreshes (default: 12)
SCHEDULER_INTERVAL_HOURS=12

# =============================================================================
# Google OAuth (required for authentication)
# =============================================================================
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# =============================================================================
# JWT Authentication (required)
# =============================================================================
# Generate a secure random string: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# =============================================================================
# Optional
# =============================================================================
LOG_LEVEL=INFO

# OpenAI API key (for future agent features)
# OPENAI_API_KEY=
